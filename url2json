#!/usr/bin/env python3
from __future__ import annotations
import json
from urllib.parse import urlparse, parse_qs
from typing import Any


def parse_url_to_json(url: str) -> dict[str, Any]:
    parsed = urlparse(url)
    params = parse_qs(parsed.query, keep_blank_values=True)

    return {
        "protocol": parsed.scheme or None,
        "username": parsed.username,
        "password": parsed.password,
        "hostname": parsed.hostname,
        "port": parsed.port,
        "path": parsed.path or None,
        "query": parsed.query or None,
        "params": {k: v[0] if len(v) == 1 else v for k, v in params.items()},
        "hash": parsed.fragment or None,
    }


def main() -> None:
    raw_input: str = open(0).read().strip()
    for url in raw_input.split("\n"):
        if not url.strip():
            continue
        result: dict[str, Any] = parse_url_to_json(url)
        print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
