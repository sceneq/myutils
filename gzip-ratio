#!/usr/bin/env python3
from __future__ import annotations

import gzip
import sys
from pathlib import Path


def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: python script.py file1 file2 file3 ...", file=sys.stderr)
        sys.exit(1)

    print(f"filepath, ratio, original_size, compressed_size")
    for filepath in sys.argv[1:]:
        path = Path(filepath)
        if not path.is_file():
            # print(f"Error: {filepath} is not a file", file=sys.stderr)
            continue

        original_size = path.stat().st_size
        compressed_data = gzip.compress(path.read_bytes())
        compressed_size = len(compressed_data)
        ratio = (1 - compressed_size / original_size) * 100 if original_size > 0 else 0

        print(f"{filepath}, {ratio:.1f}%, {original_size}, {compressed_size}")


if __name__ == "__main__":
    main()
