#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "jaconv==0.4.0",
# ]
# ///
# coding: utf-8

from __future__ import annotations

import sys
import jaconv

s = open(0).read()

com = sys.argv[1]

# Remove underscores and spaces from command
com = com.replace('_', '').replace(' ', '')

# Split by "to" or "2" to get source and target formats
parts = com.replace('to', '2').split('2')

# Map abbreviated format names to full names
format_map = {
    'hira': 'hira',
    'hiragana': 'hira',
    'kata': 'kata',
    'katakana': 'kata',
    'kana': 'kata',
    'h': 'han',
    'han': 'han',
    'hankaku': 'han',
    'z': 'zen',
    'zen': 'zen',
    'zenkaku': 'zen',
    'al': 'alphabet',
    'alpha': 'alphabet',
    'alphabet': 'alphabet',
    'hkata': 'hkata',
    'julius': 'julius',
}

# Normalize format names
if len(parts) == 2:
    src = format_map.get(parts[0].lower(), parts[0].lower())
    dst = format_map.get(parts[1].lower(), parts[1].lower())
    func_name = f"{src}2{dst}"
elif len(parts) == 1:
    # Handle cases like "normalize"
    func_name = parts[0].lower()
else:
    print(f"Invalid command format: {com}", file=sys.stderr)
    sys.exit(1)

# Map function names to jaconv functions
func_map = {
    'alphabet2kana': jaconv.alphabet2kata,
    'alphabet2kata': jaconv.alphabet2kata,
    'hira2hkata': jaconv.hira2hkata,
    'hira2kata': jaconv.hira2kata,
    'hiragana2julius': jaconv.hiragana2julius,
    'kana2alphabet': jaconv.kata2alphabet,
    'kata2alphabet': jaconv.kata2alphabet,
    'kata2hira': jaconv.kata2hira,
    'han2zen': jaconv.h2z,
    'hankaku2zenkaku': jaconv.h2z,
    'h2z': jaconv.h2z,
    'zen2han': jaconv.z2h,
    'zenkaku2hankaku': jaconv.z2h,
    'z2h': jaconv.z2h,
    'normalize': jaconv.normalize,
}

# Get the appropriate function
func = func_map.get(func_name)

if func is None:
    print(f"Unknown conversion: {func_name}", file=sys.stderr)
    print(f"Available conversions: {', '.join(func_map.keys())}", file=sys.stderr)
    sys.exit(1)

# Apply the conversion and print the result
result = func(s)
print(result, end='')
